{
  "manifest_version": 3,
  "name": "Hen → han/hun",
  "version": "0.1.0",
  "description": "Replaces the Norwegian neopronoun \"hen\" with han/hun (or han, or hun) on Norwegian pages.",
  "homepage_url": "https://github.com/vebmyk/han-hun",
  "icons": {
    "16": "icons/icon_16.png",
    "32": "icons/icon_32.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["hen.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Hen → han/hun",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/icon_16.png",
      "32": "icons/icon_32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
