{
  "manifest_version": 3,
  "name": "Hen → han/hun",
  "version": "0.1.0",
  "description": "Replaces the Norwegian neopronoun \"hen\" with han/hun (or han, or hun) on Norwegian pages.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["hen.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Hen → han/hun",
    "default_popup": "options.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
